# Environment Configuration
PORT=5000
NODE_ENV=development

# Database connection
# For SQLite (local default):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (production, e.g. Supabase / Neon / Railway / Render):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres?sslmode=require"

# JWT Secret for authentication
JWT_SECRET=super-secure-institutional-attribute3-secret-key-replace-in-production
JWT_EXPIRES_IN=7d

# File Storage configuration
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
